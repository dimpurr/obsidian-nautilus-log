{
  "name": "obsidian-nautilus-logger",
  "version": "0.5.0",
  "description": "Nautilus Logger for Obsidian — spiral day planner with explicit time capacity",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/audit-detectors.mjs && node --test test/*.test.js test/vendor/*.test.js",
    "audit": "node scripts/audit-detectors.mjs"
  },
  "keywords": [
    "obsidian",
    "planner",
    "time-blocking"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "typescript": "^5.3.0"
  }
}
