{
  "name": "obsidian-nautilus-log",
  "version": "0.0.1",
  "description": "Nautilus Log for Obsidian — spiral day planner with explicit time capacity",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test test/**/*.test.js"
  },
  "keywords": [
    "obsidian",
    "planner",
    "time-blocking"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "typescript": "^5.3.0"
  }
}
